LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=gemma-4-e4b-it
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3

DATABASE_URL=postgresql://card:card@localhost:5432/card

TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue

# Пул соединений (ресурс уровня приложения)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_S=5

# Контракт результата
LLM_STRUCTURED_ATTEMPTS=3
CONFIDENCE_THRESHOLD=0.6

# Документы поставщиков
UPLOADS_DIR=data/uploads
MAX_UPLOAD_BYTES=10485760

# Эмбеддинги и поиск
EMBEDDING_MODEL=google/embeddinggemma-300m
EMBED_DIM=768
EMBEDDING_BATCH_SIZE=32
SEARCH_MIN_SIMILARITY=0.826
SEARCH_LIMIT=5
RAG_SEARCH_LIMIT=8
RAG_CONTEXT_MAX_CHARS=6000

# Две модели: основная генерация и служебные вызовы (критик, судья)
LLM_AUX_MODEL=gemma-4-e2b-it

# Цены в микроединицах за 1M токенов (1e-6 денежной единицы)
LLM_PRICE_INPUT_MICROS_PER_1M=150000
LLM_PRICE_OUTPUT_MICROS_PER_1M=600000
LLM_AUX_PRICE_INPUT_MICROS_PER_1M=50000
LLM_AUX_PRICE_OUTPUT_MICROS_PER_1M=200000
SUSPICIOUS_CHUNK_LIMIT=2
